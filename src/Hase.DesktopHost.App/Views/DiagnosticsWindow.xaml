<Window
    x:Class="Hase.DesktopHost.App.Views.DiagnosticsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="HASE Runtime Diagnostics"
    Width="1100"
    Height="700"
    MinWidth="760"
    MinHeight="480"
    ShowInTaskbar="True"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            FontSize="24"
            FontWeight="SemiBold"
            Text="Runtime Diagnostics" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Text="Capture level" />
            <TextBlock
                Grid.Column="2"
                VerticalAlignment="Center"
                Text="{Binding CaptureMaximumLevelText}" />
            <TextBlock
                Grid.Column="4"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Text="Display filter" />
            <ComboBox
                Grid.Column="6"
                MinWidth="120"
                ItemsSource="{Binding AvailableDisplayLevels}"
                SelectedItem="{Binding SelectedDisplayMaximumLevel, Mode=TwoWay}" />
            <Button
                Grid.Column="8"
                MinWidth="90"
                AutomationProperties.Name="Pause diagnostics presentation"
                Command="{Binding PausePresentationCommand}"
                Content="Pause"
                ToolTip="Pause presentation updates. Diagnostic capture and bounded retention continue." />
            <Button
                Grid.Column="10"
                MinWidth="90"
                AutomationProperties.Name="Resume diagnostics presentation"
                Command="{Binding ResumePresentationCommand}"
                Content="Resume"
                ToolTip="Resume presentation updates and reconcile the current retained diagnostics." />
            <Button
                Grid.Column="12"
                MinWidth="130"
                Command="{Binding ClearDiagnosticsCommand}"
                Content="Clear diagnostics" />
            <Button
                Grid.Column="14"
                MinWidth="90"
                AutomationProperties.Name="Export diagnostics"
                Command="{Binding ExportDiagnosticsCommand}"
                Content="Export"
                ToolTip="Export the complete retained diagnostic session to a new file. The display filter does not change what is exported." />
        </Grid>

        <Border
            Grid.Row="4"
            Padding="10"
            Background="MistyRose"
            BorderBrush="IndianRed"
            BorderThickness="1"
            CornerRadius="3">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger
                            Binding="{Binding IsByteCaptureEnabled}"
                            Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock
                Foreground="Firebrick"
                Text="Bytes capture is active. Exact protocol frames may contain application payloads. The display filter does not change what is captured."
                TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    FontWeight="SemiBold"
                    Text="{Binding PresentationStatusText}" />
                <TextBlock
                    Grid.Column="2"
                    Foreground="DimGray"
                    Text="{Binding PresentationStatusDescription}"
                    TextWrapping="Wrap" />
            </Grid>

            <Grid Grid.Row="2">
                <TextBlock
                    Foreground="DimGray"
                    Text="{Binding DisplayedEntryCount, StringFormat=Displayed records: {0}}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="DimGray"
                    Text="{Binding ExportStatusText}"
                    TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger
                                    Binding="{Binding HasExportStatus}"
                                    Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock
                    HorizontalAlignment="Right"
                    Foreground="DimGray"
                    Text="{Binding RetainedEntryCount, StringFormat=Retained records: {0}}" />
            </Grid>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="400" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="2*" MinWidth="280" />
                </Grid.ColumnDefinitions>

                <Grid>
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="DimGray"
                        Text="No diagnostic records match the display filter."
                        TextAlignment="Center"
                        TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsEmpty}"
                                        Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <DataGrid
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        HeadersVisibility="Column"
                        HorizontalScrollBarVisibility="Auto"
                        IsReadOnly="True"
                        ItemsSource="{Binding Entries}"
                        SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                        VerticalScrollBarVisibility="Auto">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsEmpty}"
                                        Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="190"
                                Binding="{Binding TimestampUtcText}"
                                Header="Timestamp UTC" />
                            <DataGridTextColumn
                                Width="90"
                                Binding="{Binding Level}"
                                Header="Level" />
                            <DataGridTextColumn
                                Width="150"
                                Binding="{Binding Category}"
                                Header="Category" />
                            <DataGridTextColumn
                                Width="190"
                                Binding="{Binding EventName}"
                                Header="Event" />
                            <DataGridTextColumn
                                Width="160"
                                Binding="{Binding EndpointId}"
                                Header="Endpoint" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <Border
                    Grid.Column="2"
                    Padding="14"
                    BorderBrush="LightGray"
                    BorderThickness="1"
                    CornerRadius="4">
                    <Grid>
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="DimGray"
                            Text="Select a diagnostic record to inspect its details."
                            TextAlignment="Center"
                            TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger
                                            Binding="{Binding HasSelection}"
                                            Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger
                                            Binding="{Binding HasSelection}"
                                            Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <StackPanel>
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="{Binding SelectedEntry.EventName}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Margin="0,8,0,0"
                                    Text="{Binding SelectedEntry.Sequence, StringFormat=Sequence: {0}}" />
                                <TextBlock
                                    Text="{Binding SelectedEntry.Severity, StringFormat=Severity: {0}}" />
                                <TextBlock
                                    Text="{Binding SelectedEntry.EndpointId, StringFormat=Endpoint: {0}}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Text="{Binding SelectedEntry.AttachmentGeneration, StringFormat=Generation: {0}}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Text="{Binding SelectedEntry.Direction, StringFormat=Direction: {0}}" />
                                <TextBlock
                                    Text="{Binding SelectedEntry.OperationId, StringFormat=Operation: {0}}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Text="{Binding SelectedEntry.Duration, StringFormat=Duration: {0}}" />
                                <TextBlock
                                    Text="{Binding SelectedEntry.Outcome, StringFormat=Outcome: {0}}" />

                                <TextBlock
                                    Margin="0,12,0,0"
                                    FontWeight="SemiBold"
                                    Text="Details" />
                                <ItemsControl
                                    Margin="0,4,0,0"
                                    ItemsSource="{Binding SelectedEntry.Details}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" MinWidth="110" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Text="{Binding Key}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Margin="8,0,0,0"
                                                    Text="{Binding Value}"
                                                    TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Margin="0,12,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding SelectedEntry.HasByteSnapshot}"
                                                    Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="Raw captured bytes" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        Text="{Binding SelectedEntry.ByteSummary}" />
                                    <TextBox
                                        Margin="0,4,0,0"
                                        MaxHeight="180"
                                        FontFamily="Consolas"
                                        HorizontalScrollBarVisibility="Disabled"
                                        IsReadOnly="True"
                                        Text="{Binding SelectedEntry.ByteHex}"
                                        TextWrapping="Wrap"
                                        VerticalScrollBarVisibility="Auto" />

                                    <TextBlock
                                        Margin="0,16,0,0"
                                        FontWeight="SemiBold"
                                        Text="Structured interpretation" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        Text="{Binding SelectedEntry.ByteProtocolFamily, StringFormat=Protocol family: {0}}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Text="{Binding SelectedEntry.ByteInterpretationStatusText, StringFormat=Status: {0}}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        Foreground="DimGray"
                                        Text="{Binding SelectedEntry.ByteInterpretationSummary}"
                                        TextWrapping="Wrap" />
                                    <DataGrid
                                        Margin="0,8,0,0"
                                        Height="220"
                                        AutoGenerateColumns="False"
                                        CanUserAddRows="False"
                                        CanUserDeleteRows="False"
                                        HeadersVisibility="Column"
                                        HorizontalScrollBarVisibility="Auto"
                                        IsReadOnly="True"
                                        ItemsSource="{Binding SelectedEntry.ByteInterpretationFields}"
                                        VerticalScrollBarVisibility="Auto">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn
                                                Width="70"
                                                Binding="{Binding Offset}"
                                                Header="Offset" />
                                            <DataGridTextColumn
                                                Width="70"
                                                Binding="{Binding Length}"
                                                Header="Length" />
                                            <DataGridTextColumn
                                                Width="170"
                                                Binding="{Binding Name}"
                                                Header="Field" />
                                            <DataGridTextColumn
                                                Width="260"
                                                Binding="{Binding InterpretedValue}"
                                                Header="Interpreted value" />
                                            <DataGridTextColumn
                                                Width="220"
                                                Binding="{Binding ByteHex}"
                                                Header="Bytes" />
                                            <DataGridTextColumn
                                                Width="110"
                                                Binding="{Binding Validation}"
                                                Header="Validation" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
