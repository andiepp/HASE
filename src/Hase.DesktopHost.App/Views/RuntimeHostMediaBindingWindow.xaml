<Window
    x:Class="Hase.DesktopHost.App.Views.RuntimeHostMediaBindingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    Title="HASE Runtime Host Media Binding"
    Width="760"
    Height="600"
    MinWidth="640"
    MinHeight="480"
    WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,10"
            TextWrapping="Wrap"
            Text="This local preparation mode discovers exact WebView2 device bindings. It does not start the Runtime Host, publish media, change authorization, or activate the candidate." />

        <wv2:WebView2
            x:Name="BindingWebView"
            Grid.Row="1" />

        <TextBlock
            x:Name="OutcomeText"
            Grid.Row="2"
            Margin="0,10,0,0"
            Text="Initializing protected local binding mode..."
            TextWrapping="Wrap" />
    </Grid>
</Window>
