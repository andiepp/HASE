<Window
    x:Class="Hase.DesktopHost.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{Binding ApplicationTitle}"
    Width="980"
    Height="760"
    MinWidth="780"
    MinHeight="580"
    WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="EndpointStateTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="DimGray" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsReady}" Value="True">
                    <Setter Property="Foreground" Value="ForestGreen" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRecovering}" Value="True">
                    <Setter Property="Foreground" Value="DarkOrange" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFaulted}" Value="True">
                    <Setter Property="Foreground" Value="Firebrick" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDisconnected}" Value="True">
                    <Setter Property="Foreground" Value="Gray" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EndpointListItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="EndpointCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="12" />
            <Setter Property="BorderBrush" Value="LightGray" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="White" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsReady}" Value="True">
                    <Setter Property="BorderBrush" Value="DarkSeaGreen" />
                    <Setter Property="Background" Value="Honeydew" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRecovering}" Value="True">
                    <Setter Property="BorderBrush" Value="Goldenrod" />
                    <Setter Property="Background" Value="LightYellow" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFaulted}" Value="True">
                    <Setter Property="BorderBrush" Value="IndianRed" />
                    <Setter Property="Background" Value="MistyRose" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDisconnected}" Value="True">
                    <Setter Property="BorderBrush" Value="DarkGray" />
                    <Setter Property="Background" Value="WhiteSmoke" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock
                    FontSize="28"
                    FontWeight="SemiBold"
                    Text="{Binding ApplicationTitle}" />
                <TextBlock
                    Margin="0,6,0,0"
                    Foreground="DimGray"
                    Text="Operator shell for the HASE runtime-host process" />
            </StackPanel>

            <GroupBox Grid.Row="2" Header="Runtime">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock FontWeight="SemiBold" Text="Status" />
                    <TextBlock Grid.Column="1" Text="{Binding RuntimeHost.StatusText}" />

                    <TextBlock Grid.Row="2" FontWeight="SemiBold" Text="Composition" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="1"
                        Text="{Binding RuntimeHost.ShellInformation.Composition}"
                        TextWrapping="Wrap" />

                    <TextBlock Grid.Row="4" FontWeight="SemiBold" Text="Last error" />
                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="1"
                        Text="{Binding RuntimeHost.ErrorMessage, TargetNullValue=None}"
                        TextWrapping="Wrap" />
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="4" Header="Host">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock FontWeight="SemiBold" Text="Identity" />
                    <TextBlock
                        Grid.Column="1"
                        Text="{Binding RuntimeHost.ShellInformation.HostIdentity}"
                        TextWrapping="Wrap" />

                    <TextBlock Grid.Row="2" FontWeight="SemiBold" Text="API version" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="1"
                        Text="{Binding RuntimeHost.ShellInformation.ApiVersion}"
                        TextWrapping="Wrap" />
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="6" Header="Northbound API">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock FontWeight="SemiBold" Text="Loopback" />
                    <TextBlock
                        Grid.Column="1"
                        Text="{Binding RuntimeHost.ShellInformation.LoopbackBinding}"
                        TextWrapping="Wrap" />

                    <TextBlock Grid.Row="2" FontWeight="SemiBold" Text="Private network" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="1"
                        Text="{Binding RuntimeHost.ShellInformation.PrivateNetworkBinding}"
                        TextWrapping="Wrap" />
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="8" Header="Published Endpoints">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" MinHeight="250" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Text="{Binding Inventory.PublishedEndpointCount, StringFormat=Published endpoints: {0}}" />

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" MinWidth="280" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="3*" MinWidth="340" />
                        </Grid.ColumnDefinitions>

                        <ListBox
                            Grid.Column="0"
                            ItemsSource="{Binding Inventory.Endpoints}"
                            ItemContainerStyle="{StaticResource EndpointListItemStyle}"
                            SelectedItem="{Binding Inventory.SelectedEndpoint, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource EndpointCardStyle}">
                                        <StackPanel>
                                            <TextBlock
                                                FontSize="15"
                                                FontWeight="SemiBold"
                                                Text="{Binding DisplayName}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Margin="0,6,0,0"
                                                Style="{StaticResource EndpointStateTextStyle}"
                                                Text="{Binding StateIndicatorText}" />
                                            <TextBlock
                                                Margin="0,4,0,0"
                                                Foreground="DimGray"
                                                Text="{Binding EndpointId}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border
                            Grid.Column="2"
                            Padding="18"
                            BorderBrush="LightGray"
                            BorderThickness="1"
                            CornerRadius="4">
                            <Grid>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="DimGray"
                                    Text="Select a published endpoint to inspect its details."
                                    TextAlignment="Center"
                                    TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding EndpointDetails.HasSelection}"
                                                    Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding EndpointDetails.HasSelection}"
                                                    Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="16" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="16" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="16" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.ColumnSpan="2"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Text="Endpoint Details" />

                                    <TextBlock Grid.Row="2" FontWeight="SemiBold" Text="Display name" />
                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Text="{Binding EndpointDetails.DisplayName}"
                                        TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="4" FontWeight="SemiBold" Text="Endpoint ID" />
                                    <TextBlock
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        Text="{Binding EndpointDetails.EndpointId}"
                                        TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="6" FontWeight="SemiBold" Text="Connection state" />
                                    <TextBlock
                                        Grid.Row="6"
                                        Grid.Column="1"
                                        Style="{StaticResource EndpointStateTextStyle}"
                                        Text="{Binding EndpointDetails.StateIndicatorText}" />

                                    <TextBlock Grid.Row="8" FontWeight="SemiBold" Text="Generation" />
                                    <TextBlock
                                        Grid.Row="8"
                                        Grid.Column="1"
                                        FontFamily="Consolas"
                                        Text="{Binding EndpointDetails.AttachmentGeneration}"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Grid.Row="10"
                                        Grid.ColumnSpan="2"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Text="Descriptor" />

                                    <TextBlock Grid.Row="12" FontWeight="SemiBold" Text="Description" />
                                    <TextBlock
                                        Grid.Row="12"
                                        Grid.Column="1"
                                        Text="{Binding EndpointDetails.Description}"
                                        TextWrapping="Wrap" />

                                    <StackPanel
                                        Grid.Row="14"
                                        Grid.ColumnSpan="2"
                                        Margin="0,4,0,0">
                                        <TextBlock
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Text="{Binding EndpointDetails.InstrumentCount, StringFormat=Instruments ({0})}" />

                                        <ItemsControl
                                            Margin="0,10,0,0"
                                            ItemsSource="{Binding EndpointDetails.Instruments}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border
                                                        Margin="0,0,0,10"
                                                        Padding="12"
                                                        BorderBrush="LightGray"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Background="WhiteSmoke">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="120" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="6" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="6" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="6" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="6" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="6" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="12" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>

                                                            <TextBlock FontWeight="SemiBold" Text="Name" />
                                                            <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding Name}" TextWrapping="Wrap" />

                                                            <TextBlock Grid.Row="2" FontWeight="SemiBold" Text="Instrument ID" />
                                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding InstrumentId}" TextWrapping="Wrap" />

                                                            <TextBlock Grid.Row="4" FontWeight="SemiBold" Text="Kind" />
                                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Kind}" />

                                                            <TextBlock Grid.Row="6" FontWeight="SemiBold" Text="Manufacturer" />
                                                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Manufacturer}" />

                                                            <TextBlock Grid.Row="8" FontWeight="SemiBold" Text="Model" />
                                                            <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Model}" />

                                                            <TextBlock Grid.Row="10" FontWeight="SemiBold" Text="Description" />
                                                            <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding Description}" TextWrapping="Wrap" />

                                                            <StackPanel
                                                                Grid.Row="12"
                                                                Grid.ColumnSpan="2"
                                                                Margin="0,12,0,0">
                                                                <TextBlock
                                                                    FontWeight="SemiBold"
                                                                    Text="{Binding PropertyCount, StringFormat=Properties ({0})}" />

                                                                <ItemsControl
                                                                    Margin="0,8,0,0"
                                                                    ItemsSource="{Binding Properties}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border
                                                                                Margin="0,0,0,8"
                                                                                Padding="10"
                                                                                BorderThickness="1"
                                                                                CornerRadius="3">
                                                                                <Border.Style>
                                                                                    <Style TargetType="Border">
                                                                                        <Setter Property="BorderBrush" Value="Gainsboro" />
                                                                                        <Setter Property="Background" Value="White" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger
                                                                                                Binding="{Binding IsRecentlyChanged}"
                                                                                                Value="True">
                                                                                                <Setter Property="BorderBrush" Value="Goldenrod" />
                                                                                                <Setter Property="Background" Value="LightYellow" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Border.Style>
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="110" />
                                                                                        <ColumnDefinition Width="*" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <Grid.RowDefinitions>
                                                                                        <RowDefinition Height="Auto" />
                                                                                        <RowDefinition Height="5" />
                                                                                        <RowDefinition Height="Auto" />
                                                                                        <RowDefinition Height="5" />
                                                                                        <RowDefinition Height="Auto" />
                                                                                        <RowDefinition Height="5" />
                                                                                        <RowDefinition Height="Auto" />
                                                                                        <RowDefinition Height="5" />
                                                                                        <RowDefinition Height="Auto" />
                                                                                        <RowDefinition Height="5" />
                                                                                        <RowDefinition Height="Auto" />
                                                                                        <RowDefinition Height="5" />
                                                                                        <RowDefinition Height="Auto" />
                                                                                        <RowDefinition Height="5" />
                                                                                        <RowDefinition Height="Auto" />
                                                                                        <RowDefinition Height="5" />
                                                                                        <RowDefinition Height="Auto" />
                                                                                        <RowDefinition Height="5" />
                                                                                        <RowDefinition Height="Auto" />
                                                                                        <RowDefinition Height="5" />
                                                                                        <RowDefinition Height="Auto" />
                                                                                    </Grid.RowDefinitions>

                                                                                    <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                                                    <TextBlock
                                                                                        Grid.Column="1"
                                                                                        FontWeight="SemiBold"
                                                                                        Text="{Binding Value}" />

                                                                                    <TextBlock Grid.Row="2" FontWeight="SemiBold" Text="Path" />
                                                                                    <TextBlock
                                                                                        Grid.Row="2"
                                                                                        Grid.Column="1"
                                                                                        Text="{Binding Path}"
                                                                                        TextWrapping="Wrap" />

                                                                                    <TextBlock Grid.Row="4" FontWeight="SemiBold" Text="Access" />
                                                                                    <TextBlock
                                                                                        Grid.Row="4"
                                                                                        Grid.Column="1"
                                                                                        Text="{Binding Access}" />

                                                                                    <TextBlock Grid.Row="6" FontWeight="SemiBold" Text="Quality" />
                                                                                    <TextBlock
                                                                                        Grid.Row="6"
                                                                                        Grid.Column="1"
                                                                                        Text="{Binding Quality}" />

                                                                                    <TextBlock Grid.Row="8" FontWeight="SemiBold" Text="Timestamp UTC" />
                                                                                    <TextBlock
                                                                                        Grid.Row="8"
                                                                                        Grid.Column="1"
                                                                                        FontFamily="Consolas"
                                                                                        Text="{Binding TimestampUtc}"
                                                                                        TextWrapping="Wrap" />

                                                                                    <TextBlock
                                                                                        Grid.Row="10"
                                                                                        FontWeight="SemiBold"
                                                                                        Text="Requested value">
                                                                                        <TextBlock.Style>
                                                                                            <Style TargetType="TextBlock">
                                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                                                <Style.Triggers>
                                                                                                    <DataTrigger
                                                                                                        Binding="{Binding HasEditor}"
                                                                                                        Value="True">
                                                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                                                    </DataTrigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </TextBlock.Style>
                                                                                    </TextBlock>

                                                                                    <CheckBox
                                                                                        Grid.Row="10"
                                                                                        Grid.Column="1"
                                                                                        IsChecked="{Binding RequestedBooleanValue, Mode=TwoWay}"
                                                                                        IsThreeState="True">
                                                                                        <CheckBox.Style>
                                                                                            <Style TargetType="CheckBox">
                                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                                                <Style.Triggers>
                                                                                                    <DataTrigger
                                                                                                        Binding="{Binding HasBooleanEditor}"
                                                                                                        Value="True">
                                                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                                                    </DataTrigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </CheckBox.Style>
                                                                                    </CheckBox>

                                                                                    <TextBox
                                                                                        Grid.Row="10"
                                                                                        Grid.Column="1"
                                                                                        MinWidth="240"
                                                                                        HorizontalAlignment="Left"
                                                                                        Text="{Binding RequestedValueText, UpdateSourceTrigger=PropertyChanged}">
                                                                                        <TextBox.Style>
                                                                                            <Style TargetType="TextBox">
                                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                                                <Style.Triggers>
                                                                                                    <DataTrigger Binding="{Binding HasTextEditor}" Value="True">
                                                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                                                    </DataTrigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </TextBox.Style>
                                                                                    </TextBox>

                                                                                    <TextBlock
                                                                                        Grid.Row="11"
                                                                                        Grid.Column="1"
                                                                                        Margin="0,3,0,0"
                                                                                        Foreground="#FFB00020"
                                                                                        Text="{Binding ValidationMessage}"
                                                                                        TextWrapping="Wrap" />

                                                                                    <Button
                                                                                        Grid.Row="12"
                                                                                        Grid.Column="1"
                                                                                        Width="130"
                                                                                        HorizontalAlignment="Left"
                                                                                        Command="{Binding ResetRequestedValueCommand}"
                                                                                        Content="Reset to current">
                                                                                        <Button.Style>
                                                                                            <Style TargetType="Button">
                                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                                                <Style.Triggers>
                                                                                                    <DataTrigger
                                                                                                        Binding="{Binding HasEditor}"
                                                                                                        Value="True">
                                                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                                                    </DataTrigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </Button.Style>
                                                                                    </Button>

                                                                                    <StackPanel
                                                                                        Grid.Row="12"
                                                                                        Grid.Column="1"
                                                                                        Margin="140,0,0,0"
                                                                                        Orientation="Horizontal">
                                                                                        <Button
                                                                                            Width="150"
                                                                                            Command="{Binding DataContext.WritePropertyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                            CommandParameter="{Binding}"
                                                                                            Content="Write requested value">
                                                                                            <Button.Style>
                                                                                                <Style TargetType="Button">
                                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                                    <Style.Triggers>
                                                                                                        <DataTrigger
                                                                                                            Binding="{Binding HasEditor}"
                                                                                                            Value="True">
                                                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                                                        </DataTrigger>
                                                                                                    </Style.Triggers>
                                                                                                </Style>
                                                                                            </Button.Style>
                                                                                        </Button>
                                                                                    </StackPanel>

                                                                                    <StackPanel
                                                                                        Grid.Row="14"
                                                                                        Grid.ColumnSpan="2"
                                                                                        Margin="0,5,0,0">
                                                                                        <StackPanel.Style>
                                                                                            <Style TargetType="StackPanel">
                                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                                                <Style.Triggers>
                                                                                                    <DataTrigger
                                                                                                        Binding="{Binding HasEditor}"
                                                                                                        Value="True">
                                                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                                                    </DataTrigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </StackPanel.Style>
                                                                                        <TextBlock
                                                                                            FontWeight="SemiBold"
                                                                                            Text="{Binding WriteState, StringFormat=Write: {0}}" />
                                                                                        <TextBlock
                                                                                            Margin="0,3,0,0"
                                                                                            Foreground="DimGray"
                                                                                            Text="{Binding WriteMessage}"
                                                                                            TextWrapping="Wrap" />
                                                                                    </StackPanel>
                                                                                </Grid>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>

                                                                <TextBlock
                                                                    Margin="0,12,0,0"
                                                                    FontWeight="SemiBold"
                                                                    Text="{Binding CommandCount, StringFormat=Commands ({0})}" />

                                                                <ItemsControl
                                                                    Margin="0,8,0,0"
                                                                    ItemsSource="{Binding Commands}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border
                                                                                Margin="0,0,0,8"
                                                                                Padding="10"
                                                                                Background="White"
                                                                                BorderBrush="Gainsboro"
                                                                                BorderThickness="1"
                                                                                CornerRadius="3">
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="110" />
                                                                                        <ColumnDefinition Width="*" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <Grid.RowDefinitions>
                                                                                        <RowDefinition Height="Auto" />
                                                                                        <RowDefinition Height="5" />
                                                                                        <RowDefinition Height="Auto" />
                                                                                        <RowDefinition Height="5" />
                                                                                        <RowDefinition Height="Auto" />
                                                                                        <RowDefinition Height="8" />
                                                                                        <RowDefinition Height="Auto" />
                                                                                        <RowDefinition Height="8" />
                                                                                        <RowDefinition Height="Auto" />
                                                                                        <RowDefinition Height="5" />
                                                                                        <RowDefinition Height="Auto" />
                                                                                        <RowDefinition Height="5" />
                                                                                        <RowDefinition Height="Auto" />
                                                                                        <RowDefinition Height="5" />
                                                                                        <RowDefinition Height="Auto" />
                                                                                    </Grid.RowDefinitions>

                                                                                    <TextBlock FontWeight="SemiBold" Text="Command" />
                                                                                    <TextBlock
                                                                                        Grid.Column="1"
                                                                                        FontWeight="SemiBold"
                                                                                        Text="{Binding DisplayName}"
                                                                                        TextWrapping="Wrap" />

                                                                                    <TextBlock Grid.Row="2" FontWeight="SemiBold" Text="Path" />
                                                                                    <TextBlock
                                                                                        Grid.Row="2"
                                                                                        Grid.Column="1"
                                                                                        Text="{Binding Path}"
                                                                                        TextWrapping="Wrap" />

                                                                                    <TextBlock Grid.Row="4" FontWeight="SemiBold" Text="Description" />
                                                                                    <TextBlock
                                                                                        Grid.Row="4"
                                                                                        Grid.Column="1"
                                                                                        Text="{Binding Description}"
                                                                                        TextWrapping="Wrap" />

                                                                                    <StackPanel
                                                                                        Grid.Row="6"
                                                                                        Grid.ColumnSpan="2">
                                                                                        <StackPanel.Style>
                                                                                            <Style TargetType="StackPanel">
                                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                                                <Style.Triggers>
                                                                                                    <DataTrigger Binding="{Binding RequiresArgument}" Value="False">
                                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                                    </DataTrigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </StackPanel.Style>

                                                                                        <TextBlock
                                                                                            FontWeight="SemiBold"
                                                                                            Text="{Binding ArgumentDisplayName, TargetNullValue=Argument}" />

                                                                                        <TextBlock
                                                                                            Margin="0,3,0,0"
                                                                                            Foreground="DimGray"
                                                                                            Text="{Binding ArgumentDescription}"
                                                                                            TextWrapping="Wrap" />

                                                                                        <TextBlock
                                                                                            Margin="0,3,0,0"
                                                                                            Foreground="DimGray"
                                                                                            Text="{Binding ArgumentDataType, StringFormat=Data type: {0}}" />

                                                                                        <CheckBox
                                                                                            Margin="0,8,0,0"
                                                                                            Content="Requested value"
                                                                                            IsChecked="{Binding RequestedBooleanArgument, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                                                            <CheckBox.Style>
                                                                                                <Style TargetType="CheckBox">
                                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                                    <Style.Triggers>
                                                                                                        <DataTrigger Binding="{Binding HasBooleanEditor}" Value="True">
                                                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                                                        </DataTrigger>
                                                                                                    </Style.Triggers>
                                                                                                </Style>
                                                                                            </CheckBox.Style>
                                                                                        </CheckBox>

                                                                                        <TextBox
                                                                                            Margin="0,8,0,0"
                                                                                            MinWidth="220"
                                                                                            HorizontalAlignment="Left"
                                                                                            Text="{Binding RequestedArgumentText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                                                            <TextBox.Style>
                                                                                                <Style TargetType="TextBox">
                                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                                    <Style.Triggers>
                                                                                                        <DataTrigger Binding="{Binding HasTextEditor}" Value="True">
                                                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                                                        </DataTrigger>
                                                                                                    </Style.Triggers>
                                                                                                </Style>
                                                                                            </TextBox.Style>
                                                                                        </TextBox>

                                                                                        <TextBlock
                                                                                            Margin="0,5,0,0"
                                                                                            Foreground="Firebrick"
                                                                                            Text="{Binding ValidationMessage}"
                                                                                            TextWrapping="Wrap" />
                                                                                    </StackPanel>

                                                                                    <Button
                                                                                        Grid.Row="8"
                                                                                        Grid.Column="1"
                                                                                        Width="130"
                                                                                        HorizontalAlignment="Left"
                                                                                        Command="{Binding DataContext.ExecuteParameterlessCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                        CommandParameter="{Binding}"
                                                                                        Content="Execute Command"
                                                                                        IsEnabled="{Binding CanExecute}" />

                                                                                    <TextBlock
                                                                                        Grid.Row="10"
                                                                                        Grid.ColumnSpan="2"
                                                                                        FontWeight="SemiBold"
                                                                                        Text="{Binding ExecutionState, StringFormat=Execution: {0}}" />

                                                                                    <TextBlock
                                                                                        Grid.Row="12"
                                                                                        Grid.ColumnSpan="2"
                                                                                        Foreground="DimGray"
                                                                                        Text="{Binding ExecutionMessage}"
                                                                                        TextWrapping="Wrap" />

                                                                                    <TextBlock
                                                                                        Grid.Row="14"
                                                                                        Grid.ColumnSpan="2"
                                                                                        Text="{Binding ReturnValue, StringFormat=Return value: {0}}"
                                                                                        TextWrapping="Wrap">
                                                                                        <TextBlock.Style>
                                                                                            <Style TargetType="TextBlock">
                                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                                                <Style.Triggers>
                                                                                                    <DataTrigger
                                                                                                        Binding="{Binding HasReturnValue}"
                                                                                                        Value="True">
                                                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                                                    </DataTrigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </TextBlock.Style>
                                                                                    </TextBlock>
                                                                                </Grid>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>

                                                                <TextBlock
                                                                    Margin="0,12,0,0"
                                                                    FontWeight="SemiBold"
                                                                    Text="{Binding EventCount, StringFormat=Events ({0})}" />

                                                                <ItemsControl
                                                                    Margin="0,8,0,0"
                                                                    ItemsSource="{Binding Events}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border
                                                                                Margin="0,0,0,8"
                                                                                Padding="10"
                                                                                Background="White"
                                                                                BorderBrush="Gainsboro"
                                                                                BorderThickness="1"
                                                                                CornerRadius="3">
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="110" />
                                                                                        <ColumnDefinition Width="*" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <Grid.RowDefinitions>
                                                                                        <RowDefinition Height="Auto" />
                                                                                        <RowDefinition Height="5" />
                                                                                        <RowDefinition Height="Auto" />
                                                                                        <RowDefinition Height="5" />
                                                                                        <RowDefinition Height="Auto" />
                                                                                        <RowDefinition Height="5" />
                                                                                        <RowDefinition Height="Auto" />
                                                                                        <RowDefinition Height="5" />
                                                                                        <RowDefinition Height="Auto" />
                                                                                        <RowDefinition Height="5" />
                                                                                        <RowDefinition Height="Auto" />
                                                                                    </Grid.RowDefinitions>

                                                                                    <TextBlock FontWeight="SemiBold" Text="Event" />
                                                                                    <TextBlock
                                                                                        Grid.Column="1"
                                                                                        FontWeight="SemiBold"
                                                                                        Text="{Binding DisplayName}"
                                                                                        TextWrapping="Wrap" />

                                                                                    <TextBlock Grid.Row="2" FontWeight="SemiBold" Text="Path" />
                                                                                    <TextBlock
                                                                                        Grid.Row="2"
                                                                                        Grid.Column="1"
                                                                                        Text="{Binding Path}"
                                                                                        TextWrapping="Wrap" />

                                                                                    <TextBlock Grid.Row="4" FontWeight="SemiBold" Text="Description" />
                                                                                    <TextBlock
                                                                                        Grid.Row="4"
                                                                                        Grid.Column="1"
                                                                                        Text="{Binding Description}"
                                                                                        TextWrapping="Wrap" />

                                                                                    <TextBlock Grid.Row="6" FontWeight="SemiBold" Text="Payload" />
                                                                                    <TextBlock
                                                                                        Grid.Row="6"
                                                                                        Grid.Column="1"
                                                                                        Text="{Binding PayloadDisplayName}"
                                                                                        TextWrapping="Wrap" />

                                                                                    <TextBlock Grid.Row="8" FontWeight="SemiBold" Text="Payload type" />
                                                                                    <TextBlock
                                                                                        Grid.Row="8"
                                                                                        Grid.Column="1"
                                                                                        Text="{Binding PayloadDataKind}"
                                                                                        TextWrapping="Wrap" />

                                                                                    <TextBlock Grid.Row="10" FontWeight="SemiBold" Text="Payload description" />
                                                                                    <TextBlock
                                                                                        Grid.Row="10"
                                                                                        Grid.Column="1"
                                                                                        Text="{Binding PayloadDescription}"
                                                                                        TextWrapping="Wrap" />
                                                                                </Grid>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="10" Header="Operator Activity">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" MinHeight="160" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Foreground="DimGray"
                        Text="Latest 100 completed local operator actions, newest first." />

                    <DataGrid
                        Grid.Row="2"
                        Height="220"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        HeadersVisibility="Column"
                        HorizontalScrollBarVisibility="Auto"
                        IsReadOnly="True"
                        ItemsSource="{Binding Activity.Entries}"
                        VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="190"
                                Binding="{Binding TimestampUtcText}"
                                Header="Timestamp UTC" />
                            <DataGridTextColumn
                                Width="175"
                                Binding="{Binding Kind}"
                                Header="Kind" />
                            <DataGridTextColumn
                                Width="150"
                                Binding="{Binding EndpointId}"
                                Header="Endpoint" />
                            <DataGridTextColumn
                                Width="240"
                                Binding="{Binding AttachmentGeneration}"
                                Header="Attachment generation" />
                            <DataGridTextColumn
                                Width="150"
                                Binding="{Binding InstrumentId}"
                                Header="Instrument" />
                            <DataGridTextColumn
                                Width="190"
                                Binding="{Binding OperationPath}"
                                Header="Property / Command" />
                            <DataGridTextColumn
                                Width="90"
                                Binding="{Binding InputSummary}"
                                Header="Requested / argument" />
                            <DataGridTextColumn
                                Width="95"
                                Binding="{Binding Outcome}"
                                Header="Outcome" />
                            <DataGridTextColumn
                                Width="220"
                                Binding="{Binding Diagnostic}"
                                Header="Diagnostic" />
                            <DataGridTextColumn
                                Width="260"
                                Binding="{Binding Reconciliation}"
                                Header="Reconciliation" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="12" Header="Endpoint Events">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Foreground="DimGray"
                        Text="Latest 100 endpoint-originated Event occurrences, newest first." />

                    <DataGrid
                        Grid.Row="2"
                        Height="220"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        HeadersVisibility="Column"
                        HorizontalScrollBarVisibility="Auto"
                        IsReadOnly="True"
                        ItemsSource="{Binding EndpointEvents.Occurrences}"
                        VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="190"
                                Binding="{Binding OccurredAtUtcText}"
                                Header="Occurred UTC" />
                            <DataGridTextColumn
                                Width="170"
                                Binding="{Binding EndpointId}"
                                Header="Endpoint" />
                            <DataGridTextColumn
                                Width="240"
                                Binding="{Binding AttachmentGeneration}"
                                Header="Attachment generation" />
                            <DataGridTextColumn
                                Width="170"
                                Binding="{Binding InstrumentId}"
                                Header="Instrument" />
                            <DataGridTextColumn
                                Width="180"
                                Binding="{Binding EventDisplayName}"
                                Header="Event name" />
                            <DataGridTextColumn
                                Width="210"
                                Binding="{Binding EventPath}"
                                Header="Event path" />
                            <DataGridTextColumn
                                Width="150"
                                Binding="{Binding PayloadDisplayName}"
                                Header="Payload" />
                            <DataGridTextColumn
                                Width="180"
                                Binding="{Binding PayloadText}"
                                Header="Payload value" />
                            <DataGridTextColumn
                                Width="130"
                                Binding="{Binding PayloadDiagnostic}"
                                Header="Diagnostic" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>
        </Grid>
    </ScrollViewer>
</Window>
