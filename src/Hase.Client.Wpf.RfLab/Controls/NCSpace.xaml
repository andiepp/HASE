<UserControl x:Class="Hase.Client.Wpf.RfLab.NCSpace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Hase.Client.Wpf.RfLab"
             mc:Ignorable="d" 
             d:DesignHeight="70" d:DesignWidth="36"
             Height="70" Width="36">

    <Border BorderBrush="Black" BorderThickness="0" CornerRadius="0" Height="70">
        <Grid Width="Auto" Height="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="27*" />
                <ColumnDefinition Width="13*" />
            </Grid.ColumnDefinitions>
            <TextBox 
                Name="ValueTextbox" 
                Grid.ColumnSpan="2" 
                Text="." Height="Auto"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                BorderThickness="{Binding NC_BorderThickness}"
                BorderBrush="{Binding NC_BorderBrush}"
                FontFamily="{Binding NC_FontFamily}" 
                FontSize="{Binding NC_FontSize}" 
                FontWeight="{Binding NC_FontWeight}"/>
            <Button Name="Up" Grid.ColumnSpan="2" Margin="0,0,0,56" 
                Content=" " 
                Width="Auto" 
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            <Button Name="Down" Grid.ColumnSpan="2" Margin="0,58,0,0" 
                Content=" " 
                Width="Auto"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        </Grid>
    </Border>
</UserControl>
