<UserControl x:Class="Hase.Client.Wpf.RfLab.RfLabChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="46" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
            <RowDefinition Height="18" />
            <RowDefinition Height="16" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="SeriesLabel"
                   Grid.Column="2" Grid.Row="0"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontWeight="Bold" FontSize="12" Text="Sensor Data" />

        <TextBlock x:Name="ValueAxisLabel"
                   Grid.Column="0" Grid.Row="1"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="11">
            <TextBlock.LayoutTransform>
                <RotateTransform Angle="-90" />
            </TextBlock.LayoutTransform>
        </TextBlock>

        <Canvas x:Name="ValueTickCanvas" Grid.Column="1" Grid.Row="1" ClipToBounds="True" />

        <Border x:Name="PlotBorder"
                Grid.Column="2" Grid.Row="1"
                BorderThickness="1" Background="Transparent">
            <Canvas x:Name="PlotCanvas" ClipToBounds="True"
                    SizeChanged="PlotCanvasSizeChanged">
                <Polyline x:Name="SeriesLine" StrokeThickness="1.5" />
            </Canvas>
        </Border>

        <Canvas x:Name="AbscissaTickCanvas" Grid.Column="2" Grid.Row="2" ClipToBounds="True" />

        <TextBlock x:Name="AbscissaAxisLabel"
                   Grid.Column="2" Grid.Row="3"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="11" />
    </Grid>
</UserControl>
