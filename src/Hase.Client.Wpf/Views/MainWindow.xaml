<Window
    x:Class="Hase.Client.Wpf.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    Title="{Binding Title}"
    Width="960"
    Height="640"
    MinWidth="720"
    MinHeight="480"
    d:DataContext="{d:DesignInstance Type=viewModels:MainWindowViewModel}"
    mc:Ignorable="d"
    prism:ViewModelLocator.AutoWireViewModel="True"
    xmlns:viewModels="clr-namespace:Hase.Client.Wpf.ViewModels">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            FontSize="28"
            FontWeight="SemiBold"
            Text="HASE Laptop Client" />

        <Border
            Grid.Row="2"
            Padding="24"
            BorderBrush="#FFD0D0D0"
            BorderThickness="1"
            CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock FontWeight="SemiBold" Text="Session state" />
                <TextBlock Grid.Column="1" Text="{Binding SessionState}" />

                <TextBlock
                    Grid.Row="2"
                    FontWeight="SemiBold"
                    Text="Runtime host" />
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="1"
                    Text="{Binding RuntimeHostId}" />

                <TextBlock
                    Grid.Row="4"
                    FontWeight="SemiBold"
                    Text="API version" />
                <TextBlock
                    Grid.Row="4"
                    Grid.Column="1"
                    Text="{Binding ApiVersion}" />

                <TextBlock
                    Grid.Row="6"
                    FontWeight="SemiBold"
                    Text="Published endpoints" />
                <TextBlock
                    Grid.Row="6"
                    Grid.Column="1"
                    Text="{Binding EndpointCount}" />

                <StackPanel
                    Grid.Row="8"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal">
                    <Button
                        MinWidth="100"
                        Padding="16,8"
                        Command="{Binding ConnectCommand}"
                        Content="Connect" />
                    <Button
                        MinWidth="100"
                        Margin="12,0,0,0"
                        Padding="16,8"
                        Command="{Binding DisconnectCommand}"
                        Content="Disconnect" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer
            Grid.Row="3"
            Margin="0,32,0,0"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock
                    Foreground="#FFB00020"
                    Text="{Binding FailureMessage}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,12,0,0"
                    Foreground="#FF666666"
                    Text="No endpoints are currently published."
                    TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasEndpoints}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
                </TextBlock>
                <ItemsControl
                    Margin="0,12,0,0"
                    ItemsSource="{Binding Endpoints}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,0,0,12"
                            Padding="16"
                            BorderBrush="#FFD0D0D0"
                            BorderThickness="1"
                            CornerRadius="4">
                            <StackPanel>
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="{Binding DisplayName}" />
                                <TextBlock Text="{Binding EndpointId, StringFormat='Endpoint: {0}'}" />
                                <TextBlock Text="{Binding AttachmentGeneration, StringFormat='Generation: {0}'}" />
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="{Binding ConnectionState, StringFormat='State: {0}'}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#FFB00020" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsReady}" Value="True">
                                                    <Setter Property="Foreground" Value="#FF147A3D" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ItemsControl
                                    Margin="16,8,0,0"
                                    ItemsSource="{Binding Instruments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock>
                                                    <Run Text="{Binding Name}" />
                                                    <Run Text=" — " />
                                                    <Run Text="{Binding Kind}" />
                                                </TextBlock>
                                                <ItemsControl
                                                    Margin="16,4,0,8"
                                                    ItemsSource="{Binding Properties}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,2">
                                                                <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                                <TextBlock Text="{Binding Path, StringFormat='Path: {0}'}" />
                                                                <TextBlock Text="{Binding AccessMode, StringFormat='Access: {0}'}" />
                                                                <TextBlock Text="{Binding DataType, StringFormat='Type: {0}'}" />
                                                                <TextBlock Text="{Binding Unit, StringFormat='Unit: {0}'}" />
                                                                <TextBlock Text="{Binding Value, StringFormat='Value: {0}'}" />
                                                                <TextBlock Text="{Binding TimestampUtc, StringFormat='UTC: {0}'}" />
                                                                <TextBlock Text="{Binding Quality, StringFormat='Quality: {0}'}" />
                                                                <TextBlock
                                                                    Foreground="#FFB06000"
                                                                    FontWeight="SemiBold"
                                                                    Text="Retained value — endpoint unavailable">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsStale}" Value="False">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
