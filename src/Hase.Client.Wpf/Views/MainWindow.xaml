<Window
    x:Class="Hase.Client.Wpf.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    Title="{Binding Title}"
    Width="960"
    Height="640"
    MinWidth="720"
    MinHeight="480"
    d:DataContext="{d:DesignInstance Type=viewModels:MainWindowViewModel}"
    mc:Ignorable="d"
    prism:ViewModelLocator.AutoWireViewModel="True"
    xmlns:viewModels="clr-namespace:Hase.Client.Wpf.ViewModels">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            FontSize="28"
            FontWeight="SemiBold"
            Text="HASE Laptop Client" />

        <Border
            Grid.Row="2"
            Padding="24"
            BorderBrush="#FFD0D0D0"
            BorderThickness="1"
            CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock FontWeight="SemiBold" Text="Session state" />
                <TextBlock Grid.Column="1" Text="{Binding SessionState}" />

                <TextBlock
                    Grid.Row="2"
                    FontWeight="SemiBold"
                    Text="Runtime host" />
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="1"
                    Text="{Binding RuntimeHostId}" />

                <TextBlock
                    Grid.Row="4"
                    FontWeight="SemiBold"
                    Text="API version" />
                <TextBlock
                    Grid.Row="4"
                    Grid.Column="1"
                    Text="{Binding ApiVersion}" />

                <TextBlock
                    Grid.Row="6"
                    FontWeight="SemiBold"
                    Text="Published endpoints" />
                <TextBlock
                    Grid.Row="6"
                    Grid.Column="1"
                    Text="{Binding EndpointCount}" />

                <StackPanel
                    Grid.Row="8"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal">
                    <Button
                        MinWidth="100"
                        Padding="16,8"
                        Command="{Binding ConnectCommand}"
                        Content="Connect" />
                    <Button
                        MinWidth="100"
                        Margin="12,0,0,0"
                        Padding="16,8"
                        Command="{Binding DisconnectCommand}"
                        Content="Disconnect" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer
            Grid.Row="3"
            Margin="0,32,0,0"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock
                    Foreground="#FFB00020"
                    Text="{Binding FailureMessage}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,8,0,0"
                    Foreground="#FF315A7D"
                    Text="{Binding PropertyReadMessage}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,12,0,0"
                    Foreground="#FF666666"
                    Text="No endpoints are currently published."
                    TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasEndpoints}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
                </TextBlock>
                <ItemsControl
                    Margin="0,12,0,0"
                    ItemsSource="{Binding Endpoints}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,0,0,12"
                            Padding="16"
                            BorderBrush="#FFD0D0D0"
                            BorderThickness="1"
                            CornerRadius="4">
                            <StackPanel>
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="{Binding DisplayName}" />
                                <TextBlock Text="{Binding EndpointId, StringFormat='Endpoint: {0}'}" />
                                <TextBlock Text="{Binding AttachmentGeneration, StringFormat='Generation: {0}'}" />
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="{Binding ConnectionState, StringFormat='State: {0}'}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#FFB00020" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsReady}" Value="True">
                                                    <Setter Property="Foreground" Value="#FF147A3D" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ItemsControl
                                    Margin="16,8,0,0"
                                    ItemsSource="{Binding Instruments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock>
                                                    <Run Text="{Binding Name}" />
                                                    <Run Text=" — " />
                                                    <Run Text="{Binding Kind}" />
                                                </TextBlock>
                                                <ItemsControl
                                                    Margin="16,4,0,8"
                                                    ItemsSource="{Binding Properties}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,2">
                                                                <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                                <TextBlock Text="{Binding Path, StringFormat='Path: {0}'}" />
                                                                <TextBlock Text="{Binding AccessMode, StringFormat='Access: {0}'}" />
                                                                <TextBlock Text="{Binding DataType, StringFormat='Type: {0}'}" />
                                                                <TextBlock Text="{Binding Unit, StringFormat='Unit: {0}'}" />
                                                                <TextBlock Text="{Binding Value, StringFormat='Value: {0}'}" />
                                                                <TextBlock Text="{Binding TimestampUtc, StringFormat='UTC: {0}'}" />
                                                                <TextBlock Text="{Binding Quality, StringFormat='Quality: {0}'}" />
                                                                <Button
                                                                    Width="90"
                                                                    Margin="0,6,0,0"
                                                                    HorizontalAlignment="Left"
                                                                    Padding="10,4"
                                                                    Command="{Binding DataContext.ReadPropertyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Content="Read"
                                                                    IsEnabled="{Binding CanRead}">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding SupportsRead}" Value="False">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>
                                                                <StackPanel
                                                                    Margin="0,6,0,0"
                                                                    Orientation="Horizontal">
                                                                    <StackPanel.Style>
                                                                        <Style TargetType="StackPanel">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding SupportsBooleanWrite}" Value="False">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </StackPanel.Style>
                                                                    <CheckBox
                                                                        VerticalAlignment="Center"
                                                                        Content="Requested value"
                                                                        IsChecked="{Binding RequestedBooleanValue, Mode=TwoWay}"
                                                                        IsEnabled="{Binding CanWrite}" />
                                                                    <Button
                                                                        MinWidth="90"
                                                                        Margin="12,0,0,0"
                                                                        Padding="10,4"
                                                                        Command="{Binding DataContext.WriteBooleanPropertyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        Content="Write"
                                                                        IsEnabled="{Binding CanWrite}" />
                                                                </StackPanel>
                                                                <TextBlock
                                                                    Foreground="#FFB06000"
                                                                    FontWeight="SemiBold"
                                                                    Text="Retained value — endpoint unavailable">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsStale}" Value="False">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <ItemsControl
                                                    Margin="16,4,0,8"
                                                    ItemsSource="{Binding Commands}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,4">
                                                                <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                                <TextBlock Text="{Binding Path, StringFormat='Command: {0}'}" />
                                                                <TextBlock Text="{Binding Description}" />
                                                                <Border
                                                                    Margin="0,4,0,0"
                                                                    Padding="8"
                                                                    Background="#FFF5F5F5"
                                                                    BorderBrush="#FFD0D0D0"
                                                                    BorderThickness="1">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding RequiresArgument}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <StackPanel>
                                                                        <TextBlock
                                                                            FontWeight="SemiBold"
                                                                            Text="{Binding ArgumentDisplayName, StringFormat='Argument: {0}'}" />
                                                                        <TextBlock Text="{Binding ArgumentDataType, StringFormat='Type: {0}'}" />
                                                                        <TextBlock Text="{Binding ArgumentDescription}" TextWrapping="Wrap" />
                                                                        <TextBox
                                                                            MinWidth="240"
                                                                            Margin="0,6,0,0"
                                                                            HorizontalAlignment="Left"
                                                                            ToolTip="Enter hexadecimal byte pairs separated by optional whitespace."
                                                                            GotKeyboardFocus="OnCommandArgumentGotKeyboardFocus"
                                                                            LostKeyboardFocus="OnCommandArgumentLostKeyboardFocus"
                                                                            Text="{Binding RequestedArgumentText, UpdateSourceTrigger=PropertyChanged}" />
                                                                        <TextBlock
                                                                            Margin="0,4,0,0"
                                                                            Foreground="#FFB00020"
                                                                            Text="Enter complete hexadecimal byte pairs, for example: 00 7F FF"
                                                                            TextWrapping="Wrap">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding HasValidArgument}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                </Border>
                                                                <Button
                                                                    MinWidth="100"
                                                                    Margin="0,4,0,0"
                                                                    HorizontalAlignment="Left"
                                                                    Padding="10,4"
                                                                    Command="{Binding DataContext.ExecuteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Content="Execute"
                                                                    IsEnabled="{Binding CanExecute}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock
                    Margin="0,20,0,8"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Text="Live events" />
                <TextBlock
                    Foreground="#FF666666"
                    Text="No Events have occurred in this connection."
                    TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasEventOccurrences}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding EventOccurrences}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,0,0,8"
                                Padding="10"
                                BorderBrush="#FFD0D0D0"
                                BorderThickness="1">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                    <TextBlock Text="{Binding EventPath, StringFormat='Event: {0}'}" />
                                    <TextBlock Text="{Binding EndpointId, StringFormat='Endpoint: {0}'}" />
                                    <TextBlock Text="{Binding AttachmentGeneration, StringFormat='Generation: {0}'}" />
                                    <TextBlock Text="{Binding InstrumentId, StringFormat='Instrument: {0}'}" />
                                    <TextBlock Text="{Binding OccurredAtUtc, StringFormat='UTC: {0}'}" />
                                    <TextBlock Text="{Binding Sequence, StringFormat='Sequence: {0}'}" />
                                    <TextBlock Text="{Binding Value, StringFormat='Value: {0}'}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>

