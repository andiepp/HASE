<Window
    x:Class="Hase.Client.Wpf.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    Title="{Binding Title}"
    Width="960"
    Height="640"
    MinWidth="720"
    MinHeight="480"
    d:DataContext="{d:DesignInstance Type=viewModels:MainWindowViewModel}"
    mc:Ignorable="d"
    prism:ViewModelLocator.AutoWireViewModel="True"
    xmlns:viewModels="clr-namespace:Hase.Client.Wpf.ViewModels">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel>
            <Button
                DockPanel.Dock="Right"
                Padding="16,8"
                Command="{Binding OpenDiagnosticsCommand}"
                Content="Open Diagnostics" />
            <TextBlock
                VerticalAlignment="Center"
                FontSize="28"
                FontWeight="SemiBold"
                Text="HASE Laptop Client" />
        </DockPanel>

        <Border
            Grid.Row="2"
            Padding="24"
            BorderBrush="#FFD0D0D0"
            BorderThickness="1"
            CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock FontWeight="SemiBold" Text="Session state" />
                <TextBlock Grid.Column="1" Text="{Binding SessionState}" />

                <TextBlock
                    Grid.Row="2"
                    FontWeight="SemiBold"
                    Text="Runtime host" />
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="1"
                    Text="{Binding RuntimeHostId}" />

                <TextBlock
                    Grid.Row="4"
                    FontWeight="SemiBold"
                    Text="API version" />
                <TextBlock
                    Grid.Row="4"
                    Grid.Column="1"
                    Text="{Binding ApiVersion}" />

                <TextBlock
                    Grid.Row="6"
                    FontWeight="SemiBold"
                    Text="Published endpoints" />
                <TextBlock
                    Grid.Row="6"
                    Grid.Column="1"
                    Text="{Binding EndpointCount}" />

            </Grid>
        </Border>

        <ScrollViewer
            Grid.Row="3"
            Margin="0,32,0,0"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="Runtime Hosts" />
                <ListBox
                    Margin="0,8,0,0"
                    ItemsSource="{Binding RuntimeHosts}"
                    SelectedItem="{Binding SelectedRuntimeHost, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                    <TextBlock Text="{Binding ExpectedRuntimeHostId, StringFormat='Expected: {0}'}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding SessionState}" />
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding AuthoritativeRuntimeHostId, StringFormat='Connected: {0}', TargetNullValue='Not connected'}" />
                                    <TextBlock Foreground="#FFB00020" Text="{Binding FailureMessage}" />
                                    <TextBlock Text="{Binding ChangedAtUtc, StringFormat='UTC: {0:u}'}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Margin="0,8,0,20" Orientation="Horizontal">
                    <Button MinWidth="150" Padding="16,8" Command="{Binding ConnectSelectedRuntimeHostCommand}" Content="Connect Selected Host" />
                    <Button MinWidth="170" Margin="12,0,0,0" Padding="16,8" Command="{Binding DisconnectSelectedRuntimeHostCommand}" Content="Disconnect Selected Host" />
                </StackPanel>
                <Border
                    Margin="0,0,0,20"
                    Padding="16"
                    BorderBrush="#FFD0D0D0"
                    BorderThickness="1"
                    CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="Live camera" />
                            <TextBlock
                                Margin="0,4,0,12"
                                Foreground="#FF666666"
                                Text="Select a Runtime Host camera. Device identities remain local to the host."
                                TextWrapping="Wrap" />
                            <Button
                                Padding="12,6"
                                HorizontalAlignment="Left"
                                Command="{Binding Media.RefreshCommand}"
                                Content="Refresh Cameras" />
                            <ComboBox
                                MinWidth="240"
                                Margin="0,10,0,0"
                                DisplayMemberPath="DisplayName"
                                IsEnabled="{Binding Media.CanSelectSource}"
                                ItemsSource="{Binding Media.Sources}"
                                SelectedItem="{Binding Media.SelectedSource, Mode=TwoWay}" />
                            <CheckBox
                                Margin="0,10,0,0"
                                Content="Include microphone audio"
                                IsChecked="{Binding Media.IncludeAudio, Mode=TwoWay}"
                                IsEnabled="{Binding Media.CanRequestAudio}" />
                            <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                <Button
                                    MinWidth="100"
                                    Padding="12,6"
                                    Command="{Binding Media.StartCommand}"
                                    Content="Start Video" />
                                <Button
                                    MinWidth="100"
                                    Margin="10,0,0,0"
                                    Padding="12,6"
                                    Command="{Binding Media.StopCommand}"
                                    Content="Stop" />
                            </StackPanel>
                            <TextBlock
                                Margin="0,10,0,0"
                                Text="{Binding Media.SessionState, StringFormat='Media state: {0}'}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                Foreground="#FF315A7D"
                                Text="{Binding Media.StatusText}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Border
                            Grid.Column="2"
                            MinHeight="220"
                            Background="#FF101010"
                            BorderBrush="#FF303030"
                            BorderThickness="1">
                            <TextBlock
                                Margin="24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="#FFD0D0D0"
                                Text="Encrypted live video presentation is composed in Increment 55E."
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                </Border>
                <TextBlock
                    Foreground="#FFB00020"
                    Text="{Binding FailureMessage}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,8,0,0"
                    Foreground="#FF315A7D"
                    Text="{Binding PropertyReadMessage}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,12,0,0"
                    Foreground="#FF666666"
                    Text="No endpoints are currently published."
                    TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasEndpoints}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
                </TextBlock>
                <ItemsControl
                    Margin="0,12,0,0"
                    ItemsSource="{Binding Endpoints}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,0,0,12"
                            Padding="16"
                            BorderBrush="#FFD0D0D0"
                            BorderThickness="1"
                            CornerRadius="4">
                            <StackPanel>
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="{Binding DisplayName}" />
                                <TextBlock Text="{Binding EndpointId, StringFormat='Endpoint: {0}'}" />
                                <TextBlock Text="{Binding AttachmentGeneration, StringFormat='Generation: {0}'}" />
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="{Binding ConnectionState, StringFormat='State: {0}'}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#FFB00020" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsReady}" Value="True">
                                                    <Setter Property="Foreground" Value="#FF147A3D" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ItemsControl
                                    Margin="16,8,0,0"
                                    ItemsSource="{Binding Instruments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock>
                                                    <Run Text="{Binding Name}" />
                                                    <Run Text=" — " />
                                                    <Run Text="{Binding Kind}" />
                                                </TextBlock>
                                                <ItemsControl
                                                    Margin="16,4,0,8"
                                                    ItemsSource="{Binding Properties}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,2">
                                                                <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                                <TextBlock Text="{Binding Path, StringFormat='Path: {0}'}" />
                                                                <TextBlock Text="{Binding AccessMode, StringFormat='Access: {0}'}" />
                                                                <TextBlock Text="{Binding DataType, StringFormat='Type: {0}'}" />
                                                                <TextBlock Text="{Binding Unit, StringFormat='Unit: {0}'}" />
                                                                <TextBlock Text="{Binding Value, StringFormat='Value: {0}'}" />
                                                                <TextBlock Text="{Binding TimestampUtc, StringFormat='UTC: {0}'}" />
                                                                <TextBlock Text="{Binding Quality, StringFormat='Quality: {0}'}" />
                                                                <Button
                                                                    Width="90"
                                                                    Margin="0,6,0,0"
                                                                    HorizontalAlignment="Left"
                                                                    Padding="10,4"
                                                                    Command="{Binding DataContext.ReadPropertyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Content="Read"
                                                                    IsEnabled="{Binding CanRead}">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding SupportsRead}" Value="False">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>
                                                                <StackPanel Margin="0,6,0,0">
                                                                    <StackPanel.Style>
                                                                        <Style TargetType="StackPanel">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding HasEditor}" Value="False">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </StackPanel.Style>
                                                                    <CheckBox
                                                                        HorizontalAlignment="Left"
                                                                        VerticalAlignment="Center"
                                                                        Content="Requested value"
                                                                        IsChecked="{Binding RequestedBooleanValue, Mode=TwoWay}"
                                                                        IsEnabled="{Binding CanWrite}">
                                                                        <CheckBox.Style>
                                                                            <Style TargetType="CheckBox">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding HasBooleanEditor}" Value="False">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </CheckBox.Style>
                                                                    </CheckBox>
                                                                    <TextBox
                                                                        MinWidth="240"
                                                                        Margin="0,2,0,0"
                                                                        HorizontalAlignment="Left"
                                                                        GotKeyboardFocus="OnPropertyValueGotKeyboardFocus"
                                                                        LostKeyboardFocus="OnPropertyValueLostKeyboardFocus"
                                                                        Text="{Binding RequestedValueText, UpdateSourceTrigger=PropertyChanged}">
                                                                        <TextBox.Style>
                                                                            <Style TargetType="TextBox">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding HasTextEditor}" Value="False">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBox.Style>
                                                                    </TextBox>
                                                                    <TextBlock
                                                                        Margin="0,4,0,0"
                                                                        Foreground="#FFB00020"
                                                                        Text="{Binding ValidationMessage}"
                                                                        TextWrapping="Wrap">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding HasValidRequestedValue}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <Button
                                                                        MinWidth="90"
                                                                        Margin="0,6,0,0"
                                                                        HorizontalAlignment="Left"
                                                                        Padding="10,4"
                                                                        Command="{Binding DataContext.WritePropertyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        Content="Write"
                                                                        IsEnabled="{Binding CanSubmitWrite}" />
                                                                </StackPanel>
                                                                <TextBlock
                                                                    Foreground="#FFB06000"
                                                                    FontWeight="SemiBold"
                                                                    Text="Retained value — endpoint unavailable">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsStale}" Value="False">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Border
                                                    Margin="16,4,0,8"
                                                    Padding="8"
                                                    Background="#FFF5F5F5"
                                                    BorderBrush="#FFD0D0D0"
                                                    BorderThickness="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasModeSelectionSelector}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <TextBlock FontWeight="SemiBold" Text="Select mode" />
                                                        <ItemsControl
                                                            Margin="0,6,0,0"
                                                            ItemsSource="{Binding ModeSelectionCommands}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button
                                                                        MinWidth="64"
                                                                        Margin="0,0,6,6"
                                                                        Padding="10,4"
                                                                        Command="{Binding DataContext.ExecuteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        Content="{Binding ModeSelectionLabel}"
                                                                        IsEnabled="{Binding CanExecute}"
                                                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        LostMouseCapture="OnModeCommandLostMouseCapture"
                                                                        PreviewKeyDown="OnModeCommandPreviewKeyDown"
                                                                        PreviewKeyUp="OnModeCommandPreviewKeyUp"
                                                                        PreviewMouseLeftButtonDown="OnModeCommandPreviewMouseLeftButtonDown"
                                                                        PreviewMouseLeftButtonUp="OnModeCommandPreviewMouseLeftButtonUp"
                                                                        ToolTip="{Binding DisplayName}">
                                                                        <Button.Style>
                                                                            <Style TargetType="Button">
                                                                                <Setter Property="BorderThickness" Value="1" />
                                                                                <Setter Property="FontWeight" Value="Normal" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsActiveModeSelection}" Value="True">
                                                                                        <Setter Property="Background" Value="#FFE2F0D9" />
                                                                                        <Setter Property="BorderBrush" Value="#FF548235" />
                                                                                        <Setter Property="BorderThickness" Value="3" />
                                                                                        <Setter Property="FontWeight" Value="Bold" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Button.Style>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                                <Border
                                                    Margin="16,4,0,8"
                                                    Padding="8"
                                                    Background="#FFF5F5F5"
                                                    BorderBrush="#FFD0D0D0"
                                                    BorderThickness="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasInputControls}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <TextBlock FontWeight="SemiBold" Text="Input control" />
                                                        <ItemsControl
                                                            Margin="0,6,0,0"
                                                            ItemsSource="{Binding InputControlCommands}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button
                                                                        MinWidth="110"
                                                                        Margin="0,0,6,6"
                                                                        Padding="10,4"
                                                                        Command="{Binding DataContext.ExecuteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        Content="{Binding InputControlLabel}"
                                                                        IsEnabled="{Binding CanExecute}"
                                                                        LostMouseCapture="OnInputCommandLostMouseCapture"
                                                                        PreviewKeyDown="OnInputCommandPreviewKeyDown"
                                                                        PreviewKeyUp="OnInputCommandPreviewKeyUp"
                                                                        PreviewMouseLeftButtonDown="OnInputCommandPreviewMouseLeftButtonDown"
                                                                        PreviewMouseLeftButtonUp="OnInputCommandPreviewMouseLeftButtonUp"
                                                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        ToolTip="{Binding DisplayName}" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                                <Border
                                                    Margin="16,4,0,8"
                                                    Padding="8"
                                                    Background="#FFFFF2CC"
                                                    BorderBrush="#FFC55A11"
                                                    BorderThickness="2">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasConfirmedShortCircuitActivation}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <TextBlock
                                                            FontWeight="Bold"
                                                            Foreground="#FF9C0006"
                                                            Text="Confirmed SHORT activation" />
                                                        <TextBlock
                                                            Margin="0,4,0,0"
                                                            Text="This command can activate the electronic load in SHORT mode. Confirm deliberately before transmission."
                                                            TextWrapping="Wrap" />
                                                        <ContentControl
                                                            Margin="0,6,0,0"
                                                            Content="{Binding ConfirmedShortCircuitActivationCommand}">
                                                            <ContentControl.ContentTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel>
                                                                        <CheckBox
                                                                            Content="I explicitly confirm SHORT activation"
                                                                            IsChecked="{Binding IsShortCircuitActivationConfirmed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                            IsThreeState="False"
                                                                            LostMouseCapture="OnShortCircuitCommandLostMouseCapture"
                                                                            PreviewKeyDown="OnShortCircuitCommandPreviewKeyDown"
                                                                            PreviewKeyUp="OnShortCircuitCommandPreviewKeyUp"
                                                                            PreviewMouseLeftButtonDown="OnShortCircuitCommandPreviewMouseLeftButtonDown"
                                                                            PreviewMouseLeftButtonUp="OnShortCircuitCommandPreviewMouseLeftButtonUp"
                                                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ContentControl}}" />
                                                                        <TextBlock
                                                                            Margin="0,4,0,0"
                                                                            Foreground="#FFB00020"
                                                                            Text="{Binding ValidationMessage}"
                                                                            TextWrapping="Wrap" />
                                                                        <Button
                                                                            MinWidth="140"
                                                                            Margin="0,6,0,0"
                                                                            HorizontalAlignment="Left"
                                                                            Padding="10,4"
                                                                            Command="{Binding DataContext.ExecuteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}"
                                                                            Content="Activate SHORT"
                                                                            IsEnabled="{Binding CanExecute}"
                                                                            LostMouseCapture="OnShortCircuitCommandLostMouseCapture"
                                                                            PreviewKeyDown="OnShortCircuitCommandPreviewKeyDown"
                                                                            PreviewKeyUp="OnShortCircuitCommandPreviewKeyUp"
                                                                            PreviewMouseLeftButtonDown="OnShortCircuitCommandPreviewMouseLeftButtonDown"
                                                                            PreviewMouseLeftButtonUp="OnShortCircuitCommandPreviewMouseLeftButtonUp"
                                                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ContentControl}}" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ContentControl.ContentTemplate>
                                                        </ContentControl>
                                                    </StackPanel>
                                                </Border>
                                                <ItemsControl
                                                    Margin="16,4,0,8"
                                                    ItemsSource="{Binding GeneralCommands}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,4">
                                                                <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                                <TextBlock Text="{Binding Path, StringFormat='Command: {0}'}" />
                                                                <TextBlock Text="{Binding Description}" />
                                                                <Border
                                                                    Margin="0,4,0,0"
                                                                    Padding="8"
                                                                    Background="#FFF5F5F5"
                                                                    BorderBrush="#FFD0D0D0"
                                                                    BorderThickness="1">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding RequiresArgument}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <StackPanel>
                                                                        <TextBlock
                                                                            FontWeight="SemiBold"
                                                                            Text="{Binding ArgumentDisplayName, StringFormat='Argument: {0}'}" />
                                                                        <TextBlock Text="{Binding ArgumentDataType, StringFormat='Type: {0}'}" />
                                                                        <TextBlock Text="{Binding ArgumentDescription}" TextWrapping="Wrap" />
                                                                        <TextBox
                                                                            MinWidth="240"
                                                                            Margin="0,6,0,0"
                                                                            HorizontalAlignment="Left"
                                                                            ToolTip="Enter hexadecimal byte pairs separated by optional whitespace."
                                                                            GotKeyboardFocus="OnCommandArgumentGotKeyboardFocus"
                                                                            LostKeyboardFocus="OnCommandArgumentLostKeyboardFocus"
                                                                            Text="{Binding RequestedArgumentText, UpdateSourceTrigger=PropertyChanged}" />
                                                                        <TextBlock
                                                                            Margin="0,4,0,0"
                                                                            Foreground="#FFB00020"
                                                                            Text="Enter complete hexadecimal byte pairs, for example: 00 7F FF"
                                                                            TextWrapping="Wrap">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding HasValidArgument}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                </Border>
                                                                <Button
                                                                    MinWidth="100"
                                                                    Margin="0,4,0,0"
                                                                    HorizontalAlignment="Left"
                                                                    Padding="10,4"
                                                                    Command="{Binding DataContext.ExecuteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Content="Execute"
                                                                    IsEnabled="{Binding CanExecute}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock
                    Margin="0,20,0,8"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Text="Live events" />
                <TextBlock
                    Foreground="#FF666666"
                    Text="No Events have occurred in this connection."
                    TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasEventOccurrences}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding EventOccurrences}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,0,0,8"
                                Padding="10"
                                BorderBrush="#FFD0D0D0"
                                BorderThickness="1">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                    <TextBlock Text="{Binding EventPath, StringFormat='Event: {0}'}" />
                                    <TextBlock Text="{Binding EndpointId, StringFormat='Endpoint: {0}'}" />
                                    <TextBlock Text="{Binding AttachmentGeneration, StringFormat='Generation: {0}'}" />
                                    <TextBlock Text="{Binding InstrumentId, StringFormat='Instrument: {0}'}" />
                                    <TextBlock Text="{Binding OccurredAtUtc, StringFormat='UTC: {0}'}" />
                                    <TextBlock Text="{Binding Sequence, StringFormat='Sequence: {0}'}" />
                                    <TextBlock Text="{Binding PayloadDisplayName, StringFormat='Payload: {0}'}" />
                                    <TextBlock Text="{Binding PayloadText, StringFormat='Payload value: {0}'}" />
                                    <TextBlock Text="{Binding PayloadDescription, StringFormat='Description: {0}'}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasPayloadDescription}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock
                                        Foreground="#FFB04000"
                                        Text="{Binding PayloadStatus, StringFormat='Payload status: {0}'}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasPayloadDiagnostic}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
