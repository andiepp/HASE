<Window
    x:Class="Hase.Client.Wpf.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    Title="{Binding Title}"
    Width="960"
    Height="640"
    MinWidth="720"
    MinHeight="480"
    d:DataContext="{d:DesignInstance Type=viewModels:MainWindowViewModel}"
    mc:Ignorable="d"
    prism:ViewModelLocator.AutoWireViewModel="True"
    xmlns:viewModels="clr-namespace:Hase.Client.Wpf.ViewModels">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            FontSize="28"
            FontWeight="SemiBold"
            Text="HASE Laptop Client" />

        <Border
            Grid.Row="2"
            Padding="24"
            BorderBrush="#FFD0D0D0"
            BorderThickness="1"
            CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock FontWeight="SemiBold" Text="Session state" />
                <TextBlock Grid.Column="1" Text="{Binding SessionState}" />

                <TextBlock
                    Grid.Row="2"
                    FontWeight="SemiBold"
                    Text="Runtime host" />
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="1"
                    Text="{Binding RuntimeHostId}" />

                <TextBlock
                    Grid.Row="4"
                    FontWeight="SemiBold"
                    Text="API version" />
                <TextBlock
                    Grid.Row="4"
                    Grid.Column="1"
                    Text="{Binding ApiVersion}" />
            </Grid>
        </Border>

        <TextBlock
            Grid.Row="3"
            Margin="0,32,0,0"
            Foreground="#FF666666"
            Text="Connection configuration and endpoint inventory will be added in the next reviewed increments."
            TextWrapping="Wrap" />
    </Grid>
</Window>
