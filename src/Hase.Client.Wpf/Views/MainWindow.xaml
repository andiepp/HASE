<Window
    x:Class="Hase.Client.Wpf.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:viewModels="clr-namespace:Hase.Client.Wpf.ViewModels"
    Title="{Binding Title}"
    Width="1280"
    Height="760"
    MinWidth="960"
    MinHeight="560"
    d:DataContext="{d:DesignInstance Type=viewModels:MainWindowViewModel}"
    mc:Ignorable="d"
    prism:ViewModelLocator.AutoWireViewModel="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button MinWidth="120" Padding="16,8"
                        Command="{Binding OpenMediaCommand}"
                        Content="Video / Audio"
                        ToolTip="Open Runtime Host video and audio controls" />
                <Button MinWidth="130" Margin="10,0,0,0" Padding="16,8"
                        Command="{Binding OpenDiagnosticsCommand}"
                        Content="Open Diagnostics" />
            </StackPanel>
            <TextBlock VerticalAlignment="Center" FontSize="28" FontWeight="SemiBold"
                       Text="HASE Laptop Client" />
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="12" BorderBrush="#FFD0D0D0" BorderThickness="1" CornerRadius="6">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,10" FontSize="18" FontWeight="SemiBold" Text="Runtime Hosts" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ListBox ItemsSource="{Binding RuntimeHosts}" SelectedItem="{Binding SelectedRuntimeHost, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FFF3F3F3" />
                                                <Setter Property="BorderBrush" Value="#FFB8B8B8" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SessionState}" Value="Connected">
                                                        <Setter Property="Background" Value="#FFC6EFCE" />
                                                        <Setter Property="BorderBrush" Value="#FF70AD47" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#FF315A7D" />
                                                        <Setter Property="BorderThickness" Value="3" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,3,0,0" Text="{Binding SessionState}" />
                                                <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="#FF666666"
                                                           Text="{Binding ExpectedRuntimeHostId, StringFormat='Expected: {0}'}" />
                                                <TextBlock Margin="0,3,0,0" Foreground="#FFB00020" TextWrapping="Wrap" Text="{Binding FailureMessage}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Margin="8,0,0,0" Padding="10,3" MinWidth="82"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Command="{Binding DataContext.ToggleRuntimeHostConnectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Content="{Binding ConnectionActionLabel}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Padding="12" BorderBrush="#FFD0D0D0" BorderThickness="1" CornerRadius="6">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Endpoints" />
                        <TextBlock Margin="0,4,0,0" Foreground="#FF666666" Text="{Binding RuntimeHostId, StringFormat='Host: {0}'}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Endpoints}" SelectedItem="{Binding SelectedEndpoint, Mode=TwoWay}"
                             BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Padding="10" CornerRadius="4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="#FFD0D0D0" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#FF315A7D" />
                                                    <Setter Property="BorderThickness" Value="3" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,3,0,0" FontSize="11" Text="{Binding EndpointId, StringFormat='Endpoint: {0}'}" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,3,0,0" FontWeight="SemiBold" Text="{Binding ConnectionState}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#FFB00020" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsReady}" Value="True">
                                                            <Setter Property="Foreground" Value="#FF147A3D" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="4" Padding="12" BorderBrush="#FFD0D0D0" BorderThickness="1" CornerRadius="6">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Selected Endpoint" />
                        <TextBlock Margin="0,4,0,0" Foreground="#FF666666"
                                   Text="Select an endpoint to view and operate its properties and commands." TextWrapping="Wrap" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ContentControl Content="{Binding SelectedEndpoint}">
                            <ContentControl.ContentTemplate>
<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:prism="http://prismlibrary.com/" xmlns:viewModels="clr-namespace:Hase.Client.Wpf.ViewModels">
                        <Border Margin="0,0,0,12" Padding="16" BorderBrush="#FFD0D0D0" BorderThickness="1" CornerRadius="4">
                            <StackPanel>
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding DisplayName}"/>
                                <TextBlock Text="{Binding EndpointId, StringFormat='Endpoint: {0}'}"/>
                                <TextBlock Text="{Binding AttachmentGeneration, StringFormat='Generation: {0}'}"/>
                                <TextBlock FontWeight="SemiBold" Text="{Binding ConnectionState, StringFormat='State: {0}'}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#FFB00020"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsReady}" Value="True">
                                                    <Setter Property="Foreground" Value="#FF147A3D"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ItemsControl Margin="16,8,0,0" ItemsSource="{Binding Instruments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock>
                                                    <Run Text="{Binding Name}"/>
                                                    <Run Text=" — "/>
                                                    <Run Text="{Binding Kind}"/>
                                                </TextBlock>
                                                <ItemsControl Margin="16,4,0,8" ItemsSource="{Binding PropertyGroups}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="0,2,0,8" Padding="10" BorderBrush="#FFD0D0D0" BorderThickness="1" CornerRadius="4">
                                                                <StackPanel>
                                                                    <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}"/>
                                                                    <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Members}">
                                                                        <ItemsControl.Style>
                                                                            <Style TargetType="ItemsControl">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsCurve}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </ItemsControl.Style>
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <StackPanel Orientation="Horizontal"/>
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <StackPanel Margin="0,0,24,0" MinWidth="96">
                                                                                    <TextBlock FontSize="11" Foreground="#FF666666" Text="{Binding DisplayName}"/>
                                                                                    <TextBlock FontSize="18" Text="{Binding Value}"/>
                                                                                    <TextBlock FontSize="11" Foreground="#FF666666" Text="{Binding Quality, StringFormat='Quality: {0}'}"/>
                                                                                </StackPanel>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                    <Grid Margin="0,6,0,0">
                                                                        <Grid.Style>
                                                                            <Style TargetType="Grid">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsCurve}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Grid.Style>
                                                                        <StackPanel>
                                                                            <TextBlock FontSize="11" Foreground="#FF666666" Text="{Binding MaximumValueText, StringFormat='Maximum: {0}'}"/>
                                                                            <Border Margin="0,2,0,0" HorizontalAlignment="Left" Background="#FFFAFAFA" BorderBrush="#FFD0D0D0" BorderThickness="1">
                                                                                <Canvas Width="460" Height="170">
                                                                                    <Polyline Points="{Binding PolylinePoints}" Stroke="#FF2A6FB0" StrokeThickness="1.5"/>
                                                                                    <ItemsControl ItemsSource="{Binding CurvePoints}">
                                                                                        <ItemsControl.ItemsPanel>
                                                                                            <ItemsPanelTemplate>
                                                                                                <Canvas/>
                                                                                            </ItemsPanelTemplate>
                                                                                        </ItemsControl.ItemsPanel>
                                                                                        <ItemsControl.ItemContainerStyle>
                                                                                            <Style TargetType="ContentPresenter">
                                                                                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                                                                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                                                                            </Style>
                                                                                        </ItemsControl.ItemContainerStyle>
                                                                                        <ItemsControl.ItemTemplate>
                                                                                            <DataTemplate>
                                                                                                <Ellipse Width="7" Height="7" Margin="-3.5,-3.5,0,0" Fill="#FF2A6FB0" ToolTip="{Binding Tooltip}"/>
                                                                                            </DataTemplate>
                                                                                        </ItemsControl.ItemTemplate>
                                                                                    </ItemsControl>
                                                                                </Canvas>
                                                                            </Border>
                                                                            <Grid Width="462" HorizontalAlignment="Left" Margin="0,2,0,0">
                                                                                <TextBlock FontSize="11" Foreground="#FF666666" HorizontalAlignment="Left" Text="{Binding MinimumAbscissaText}"/>
                                                                                <TextBlock FontSize="11" Foreground="#FF666666" HorizontalAlignment="Right" Text="{Binding MaximumAbscissaText}"/>
                                                                            </Grid>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                    <TextBlock Margin="0,6,0,0" Text="{Binding Unit, StringFormat='Unit: {0}'}"/>
                                                                    <TextBlock Text="{Binding OldestTimestampUtc, StringFormat='UTC: {0}'}"/>
                                                                    <Button Width="90" Margin="0,6,0,0" HorizontalAlignment="Left" Padding="10,4" Command="{Binding DataContext.ReadPropertyGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Content="Read" IsEnabled="{Binding CanRead}">
                                                                        <Button.Style>
                                                                            <Style TargetType="Button">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding SupportsRead}" Value="False">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Button.Style>
                                                                    </Button>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <ItemsControl Margin="16,4,0,8" ItemsSource="{Binding UngroupedProperties}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,2">
                                                                <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}"/>
                                                                <TextBlock Text="{Binding Path, StringFormat='Path: {0}'}"/>
                                                                <TextBlock Text="{Binding AccessMode, StringFormat='Access: {0}'}"/>
                                                                <TextBlock Text="{Binding DataType, StringFormat='Type: {0}'}"/>
                                                                <TextBlock Text="{Binding Unit, StringFormat='Unit: {0}'}"/>
                                                                <TextBlock Text="{Binding Value, StringFormat='Value: {0}'}"/>
                                                                <TextBlock Text="{Binding TimestampUtc, StringFormat='UTC: {0}'}"/>
                                                                <TextBlock Text="{Binding Quality, StringFormat='Quality: {0}'}"/>
                                                                <Button Width="90" Margin="0,6,0,0" HorizontalAlignment="Left" Padding="10,4" Command="{Binding DataContext.ReadPropertyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Content="Read" IsEnabled="{Binding CanRead}">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding SupportsRead}" Value="False">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>
                                                                <StackPanel Margin="0,6,0,0">
                                                                    <StackPanel.Style>
                                                                        <Style TargetType="StackPanel">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding HasEditor}" Value="False">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </StackPanel.Style>
                                                                    <CheckBox HorizontalAlignment="Left" VerticalAlignment="Center" Content="Requested value" IsChecked="{Binding RequestedBooleanValue, Mode=TwoWay}" IsEnabled="{Binding CanWrite}">
                                                                        <CheckBox.Style>
                                                                            <Style TargetType="CheckBox">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding HasBooleanEditor}" Value="False">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </CheckBox.Style>
                                                                    </CheckBox>
                                                                    <TextBox MinWidth="240" Margin="0,2,0,0" HorizontalAlignment="Left" GotKeyboardFocus="OnPropertyValueGotKeyboardFocus" LostKeyboardFocus="OnPropertyValueLostKeyboardFocus" Text="{Binding RequestedValueText, UpdateSourceTrigger=PropertyChanged}">
                                                                        <TextBox.Style>
                                                                            <Style TargetType="TextBox">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding HasTextEditor}" Value="False">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBox.Style>
                                                                    </TextBox>
                                                                    <TextBlock Margin="0,4,0,0" Foreground="#FFB00020" Text="{Binding ValidationMessage}" TextWrapping="Wrap">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding HasValidRequestedValue}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <Button MinWidth="90" Margin="0,6,0,0" HorizontalAlignment="Left" Padding="10,4" Command="{Binding DataContext.WritePropertyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Content="Write" IsEnabled="{Binding CanSubmitWrite}"/>
                                                                </StackPanel>
                                                                <TextBlock Foreground="#FFB06000" FontWeight="SemiBold" Text="Retained value — endpoint unavailable">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsStale}" Value="False">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Border Margin="16,4,0,8" Padding="8" Background="#FFF5F5F5" BorderBrush="#FFD0D0D0" BorderThickness="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasModeSelectionSelector}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <TextBlock FontWeight="SemiBold" Text="Select mode"/>
                                                        <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding ModeSelectionCommands}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button MinWidth="64" Margin="0,0,6,6" Padding="10,4" Command="{Binding DataContext.ExecuteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Content="{Binding ModeSelectionLabel}" IsEnabled="{Binding CanExecute}" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}" LostMouseCapture="OnModeCommandLostMouseCapture" PreviewKeyDown="OnModeCommandPreviewKeyDown" PreviewKeyUp="OnModeCommandPreviewKeyUp" PreviewMouseLeftButtonDown="OnModeCommandPreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="OnModeCommandPreviewMouseLeftButtonUp" ToolTip="{Binding DisplayName}">
                                                                        <Button.Style>
                                                                            <Style TargetType="Button">
                                                                                <Setter Property="BorderThickness" Value="1"/>
                                                                                <Setter Property="FontWeight" Value="Normal"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsActiveModeSelection}" Value="True">
                                                                                        <Setter Property="Background" Value="#FFE2F0D9"/>
                                                                                        <Setter Property="BorderBrush" Value="#FF548235"/>
                                                                                        <Setter Property="BorderThickness" Value="3"/>
                                                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Button.Style>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                                <Border Margin="16,4,0,8" Padding="8" Background="#FFF5F5F5" BorderBrush="#FFD0D0D0" BorderThickness="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasInputControls}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <TextBlock FontWeight="SemiBold" Text="Input control"/>
                                                        <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding InputControlCommands}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button MinWidth="110" Margin="0,0,6,6" Padding="10,4" Command="{Binding DataContext.ExecuteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Content="{Binding InputControlLabel}" IsEnabled="{Binding CanExecute}" LostMouseCapture="OnInputCommandLostMouseCapture" PreviewKeyDown="OnInputCommandPreviewKeyDown" PreviewKeyUp="OnInputCommandPreviewKeyUp" PreviewMouseLeftButtonDown="OnInputCommandPreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="OnInputCommandPreviewMouseLeftButtonUp" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}" ToolTip="{Binding DisplayName}"/>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                                <Border Margin="16,4,0,8" Padding="8" Background="#FFFFF2CC" BorderBrush="#FFC55A11" BorderThickness="2">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasConfirmedShortCircuitActivation}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <TextBlock FontWeight="Bold" Foreground="#FF9C0006" Text="Confirmed SHORT activation"/>
                                                        <TextBlock Margin="0,4,0,0" Text="This command can activate the electronic load in SHORT mode. Confirm deliberately before transmission." TextWrapping="Wrap"/>
                                                        <ContentControl Margin="0,6,0,0" Content="{Binding ConfirmedShortCircuitActivationCommand}">
                                                            <ContentControl.ContentTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel>
                                                                        <CheckBox Content="I explicitly confirm SHORT activation" IsChecked="{Binding IsShortCircuitActivationConfirmed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsThreeState="False" LostMouseCapture="OnShortCircuitCommandLostMouseCapture" PreviewKeyDown="OnShortCircuitCommandPreviewKeyDown" PreviewKeyUp="OnShortCircuitCommandPreviewKeyUp" PreviewMouseLeftButtonDown="OnShortCircuitCommandPreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="OnShortCircuitCommandPreviewMouseLeftButtonUp" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ContentControl}}"/>
                                                                        <TextBlock Margin="0,4,0,0" Foreground="#FFB00020" Text="{Binding ValidationMessage}" TextWrapping="Wrap"/>
                                                                        <Button MinWidth="140" Margin="0,6,0,0" HorizontalAlignment="Left" Padding="10,4" Command="{Binding DataContext.ExecuteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Content="Activate SHORT" IsEnabled="{Binding CanExecute}" LostMouseCapture="OnShortCircuitCommandLostMouseCapture" PreviewKeyDown="OnShortCircuitCommandPreviewKeyDown" PreviewKeyUp="OnShortCircuitCommandPreviewKeyUp" PreviewMouseLeftButtonDown="OnShortCircuitCommandPreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="OnShortCircuitCommandPreviewMouseLeftButtonUp" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ContentControl}}"/>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ContentControl.ContentTemplate>
                                                        </ContentControl>
                                                    </StackPanel>
                                                </Border>
                                                <ItemsControl Margin="16,4,0,8" ItemsSource="{Binding GeneralCommands}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,4">
                                                                <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}"/>
                                                                <TextBlock Text="{Binding Path, StringFormat='Command: {0}'}"/>
                                                                <TextBlock Text="{Binding Description}"/>
                                                                <Border Margin="0,4,0,0" Padding="8" Background="#FFF5F5F5" BorderBrush="#FFD0D0D0" BorderThickness="1">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding RequiresArgument}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <StackPanel>
                                                                        <TextBlock FontWeight="SemiBold" Text="{Binding ArgumentDisplayName, StringFormat='Argument: {0}'}"/>
                                                                        <TextBlock Text="{Binding ArgumentDataType, StringFormat='Type: {0}'}"/>
                                                                        <TextBlock Text="{Binding ArgumentDescription}" TextWrapping="Wrap"/>
                                                                        <TextBox MinWidth="240" Margin="0,6,0,0" HorizontalAlignment="Left" ToolTip="Enter hexadecimal byte pairs separated by optional whitespace." GotKeyboardFocus="OnCommandArgumentGotKeyboardFocus" LostKeyboardFocus="OnCommandArgumentLostKeyboardFocus" Text="{Binding RequestedArgumentText, UpdateSourceTrigger=PropertyChanged}"/>
                                                                        <TextBlock Margin="0,4,0,0" Foreground="#FFB00020" Text="Enter complete hexadecimal byte pairs, for example: 00 7F FF" TextWrapping="Wrap">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding HasValidArgument}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                </Border>
                                                                <Button MinWidth="100" Margin="0,4,0,0" HorizontalAlignment="Left" Padding="10,4" Command="{Binding DataContext.ExecuteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Content="Execute" IsEnabled="{Binding CanExecute}"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>


                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Foreground="#FFB00020" Text="{Binding FailureMessage}" TextWrapping="Wrap" />
            <TextBlock Margin="0,4,0,0" Foreground="#FF315A7D" Text="{Binding PropertyReadMessage}" TextWrapping="Wrap" />
        </StackPanel>

    </Grid>
</Window>
