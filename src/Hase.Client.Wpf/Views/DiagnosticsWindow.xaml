<Window
    x:Class="Hase.Client.Wpf.Views.DiagnosticsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{Binding Title}"
    Width="1120"
    Height="700"
    MinWidth="820"
    MinHeight="520">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>
        <DockPanel>
            <Button
                DockPanel.Dock="Right"
                MinWidth="80"
                Padding="12,6"
                Command="{Binding ClearCommand}"
                Content="Clear" />
            <Button
                DockPanel.Dock="Right"
                MinWidth="80"
                Margin="0,0,8,0"
                Padding="12,6"
                Command="{Binding ResumeCommand}"
                Content="Resume" />
            <Button
                DockPanel.Dock="Right"
                MinWidth="80"
                Margin="0,0,8,0"
                Padding="12,6"
                Command="{Binding PauseCommand}"
                Content="Pause" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="Level" />
                <ComboBox Width="130" ItemsSource="{Binding LevelFilters}" SelectedItem="{Binding SelectedLevelFilter}" />
                <TextBlock Margin="16,0,8,0" VerticalAlignment="Center" Text="Category" />
                <ComboBox Width="190" ItemsSource="{Binding CategoryFilters}" SelectedItem="{Binding SelectedCategoryFilter}" />
                <TextBlock Margin="20,0,0,0" VerticalAlignment="Center" Text="{Binding RecordCount, StringFormat='Records: {0}'}" />
                <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Text="{Binding EvictedRecordCount, StringFormat='Evicted: {0}'}" />
                <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding PresentationState}" />
                <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Text="{Binding PendingRecordCount, StringFormat='Pending: {0}'}" />
            </StackPanel>
        </DockPanel>
        <DataGrid
            x:Name="RecordsGrid"
            Grid.Row="2"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            SelectionMode="Single"
            SelectedItem="{Binding SelectedRecord}"
            ItemsSource="{Binding Records}">
            <DataGrid.Columns>
                <DataGridTextColumn Width="70" Header="Seq" Binding="{Binding Sequence}" />
                <DataGridTextColumn Width="190" Header="UTC" Binding="{Binding TimestampUtc, StringFormat=O}" />
                <DataGridTextColumn Width="95" Header="Level" Binding="{Binding Level}" />
                <DataGridTextColumn Width="150" Header="Category" Binding="{Binding Category}" />
                <DataGridTextColumn Width="190" Header="Event" Binding="{Binding EventName}" />
                <DataGridTextColumn Width="90" Header="Severity" Binding="{Binding Severity}" />
                <DataGridTextColumn Width="90" Header="Direction" Binding="{Binding Direction}" />
                <DataGridTextColumn Width="90" Header="Outcome" Binding="{Binding Outcome}" />
            </DataGrid.Columns>
        </DataGrid>
        <Border
            Grid.Row="2"
            Margin="12"
            Padding="16"
            VerticalAlignment="Top"
            Background="#FFFFF4CE"
            BorderBrush="#FFE0B000"
            BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBytesUnavailable}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding BytesUnavailableMessage}" TextWrapping="Wrap" />
        </Border>
        <ScrollViewer Grid.Row="4" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock FontWeight="SemiBold" Text="Operation" /><TextBlock Grid.Column="1" Text="{Binding SelectedRecord.OperationId}" />
                <TextBlock Grid.Row="1" FontWeight="SemiBold" Text="Duration" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedRecord.Duration}" />
                <TextBlock Grid.Row="2" FontWeight="SemiBold" Text="Endpoint" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedRecord.EndpointId}" />
                <TextBlock Grid.Row="3" FontWeight="SemiBold" Text="Generation" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedRecord.AttachmentGeneration}" />
                <TextBlock Grid.Row="4" FontWeight="SemiBold" Text="Instrument" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedRecord.InstrumentId}" />
                <TextBlock Grid.Row="5" FontWeight="SemiBold" Text="Descriptor path" /><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedRecord.DescriptorPath}" />
                <TextBlock Grid.Row="6" FontWeight="SemiBold" Text="Metadata" /><TextBlock Grid.Row="6" Grid.Column="1" FontFamily="Consolas" Text="{Binding MetadataText}" TextWrapping="Wrap" />
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
