<Window
    x:Class="Hase.Client.Wpf.Views.MediaWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="HASE Video / Audio"
    Width="980"
    Height="680"
    MinWidth="760"
    MinHeight="520"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Padding="16"
                BorderBrush="#FFD0D0D0" BorderThickness="1" CornerRadius="6">
            <StackPanel>
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="Video / Audio" />
                <TextBlock Margin="0,4,0,14" Foreground="#FF666666"
                           Text="Select a Runtime Host camera. Device identities remain local to the host."
                           TextWrapping="Wrap" />

                <Button HorizontalAlignment="Left" Padding="12,6"
                        Command="{Binding RefreshCommand}"
                        Content="Refresh Cameras" />

                <ComboBox MinWidth="240" Margin="0,12,0,0"
                          DisplayMemberPath="DisplayName"
                          IsEnabled="{Binding CanSelectSource}"
                          ItemsSource="{Binding Sources}"
                          SelectedItem="{Binding SelectedSource, Mode=TwoWay}" />

                <CheckBox Margin="0,12,0,0"
                          Content="Include microphone audio"
                          IsChecked="{Binding IncludeAudio, Mode=TwoWay}"
                          IsEnabled="{Binding CanRequestAudio}" />

                <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                    <Button MinWidth="100" Padding="12,6"
                            Command="{Binding StartCommand}"
                            Content="Start Video" />
                    <Button MinWidth="100" Margin="10,0,0,0" Padding="12,6"
                            Command="{Binding StopCommand}"
                            Content="Stop" />
                </StackPanel>

                <TextBlock Margin="0,14,0,0"
                           Text="{Binding SessionState, StringFormat='Media state: {0}'}" />
                <TextBlock Margin="0,6,0,0" Foreground="#FF315A7D"
                           Text="{Binding StatusText}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Column="2" MinHeight="360"
                Background="#FF101010"
                BorderBrush="#FF303030" BorderThickness="1">
            <ContentControl x:Name="MediaPresentationHost" />
        </Border>
    </Grid>
</Window>
